# =============================================================================
# BTB Service — Configuration File
# =============================================================================
#
# Copy this file to /etc/btb-service/config.env and edit the values.
# All keys listed below are REQUIRED unless noted otherwise.
#
# Format: KEY=value (one per line, # for comments)
# Values may optionally be quoted with single or double quotes.
#
# Requirements satisfied: 8.1, 8.2
# =============================================================================

# ---------------------------------------------------------------------------
# Webhook Configuration
# ---------------------------------------------------------------------------

# Shared secret for validating GitHub webhook signatures (X-Hub-Signature-256).
# Must match the secret configured in the GitHub webhook settings.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-random-secret

# GitHub personal access token (classic) or fine-grained token.
# Required for checking .btb files via the GitHub Contents API.
# Needs "contents: read" permission on target repositories.
GITHUB_TOKEN=ghp_your_github_token_here

# ---------------------------------------------------------------------------
# Directory Paths
# ---------------------------------------------------------------------------

# Directory where pending job JSON files are stored (FIFO queue).
QUEUE_DIR=/var/btb/queue

# Directory where completed job JSON files are moved after execution.
COMPLETED_DIR=/var/btb/completed

# Base directory for job working directories (cloned repos, worktrees).
# Each job gets a subdirectory: /var/btb/jobs/{job_id}/
JOBS_DIR=/var/btb/jobs

# Directory for preserved btb log files (.ralph-logs/) after job cleanup.
# Each job's logs are stored in: /var/btb/logs/{job_id}/
LOGS_DIR=/var/btb/logs

# Path to the btb installation directory (where btb.sh lives).
BTB_PATH=/opt/btb

# ---------------------------------------------------------------------------
# Server Settings
# ---------------------------------------------------------------------------

# Port the service listens on for HTTPS connections.
# Default: 8443. Use 443 if you want standard HTTPS (requires root or CAP_NET_BIND_SERVICE).
PORT=8443

# Path to the TLS certificate file (PEM format).
# For a self-signed cert: openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
TLS_CERT=/etc/btb-service/cert.pem

# Path to the TLS private key file (PEM format).
TLS_KEY=/etc/btb-service/key.pem

# ---------------------------------------------------------------------------
# Job Limits
# ---------------------------------------------------------------------------

# Maximum time (in seconds) a single btb job is allowed to run.
# Jobs exceeding this timeout are terminated. Default: 7200 (2 hours).
JOB_TIMEOUT=7200

# Number of days to retain completed job data and logs.
# Jobs older than this are automatically cleaned up. Default: 7 days.
LOG_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# AWS / Authentication
# ---------------------------------------------------------------------------

# AWS CLI profile name for IAM Identity Center SSO credentials.
# The instance should have an IAM instance profile attached (Requirement 1.2).
# kiro-cli uses these credentials for authentication.
# Team members managed via IAM Identity Center can submit jobs without
# instance reconfiguration (Requirements 2.1, 2.2).
AWS_PROFILE=btb-service

# ---------------------------------------------------------------------------
# EC2 Worker Mode (optional)
# ---------------------------------------------------------------------------
# When set, jobs run on a separate "worker" EC2 instance instead of locally.
# The coordinator (this instance) stays lightweight — just webhooks + dashboard.
# The worker starts on demand and stops itself after each job, so you only
# pay for compute while jobs are running.
#
# Requirements:
#   - boto3 installed on the coordinator (pip3 install boto3)
#   - IAM role on coordinator with: ec2:StartInstances, ec2:StopInstances,
#     ec2:DescribeInstances, ssm:SendCommand, ssm:GetCommandInvocation
#   - Worker instance with SSM agent + AmazonSSMManagedInstanceCore IAM role
#   - Worker instance pre-configured with btb, kiro-cli, git, python3
#
# Leave both blank/commented to run jobs locally (original behavior).

# WORKER_INSTANCE_ID=i-0abc123def456789
# WORKER_REGION=us-east-2
