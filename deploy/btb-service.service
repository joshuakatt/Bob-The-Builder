# =============================================================================
# BTB Service — systemd Unit File
# =============================================================================
#
# Install to: /etc/systemd/system/btb-service.service
#
# Then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable btb-service
#   sudo systemctl start btb-service
#
# Requirements satisfied:
#   1.3 — BTB_Service starts automatically via systemd (enabled on boot)
#   1.5 — systemd restarts the service within 10 seconds on crash
#         (Restart=on-failure, RestartSec=10)
# =============================================================================

[Unit]
Description=BTB Service — Bob the Builder Team Service
Documentation=https://github.com/your-org/btb
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=btb
Group=btb
WorkingDirectory=/opt/btb

# Start the BTB service with the config file path as argument
ExecStart=/usr/bin/python3 -m server.main /etc/btb-service/config.env

# Restart policy (Requirement 1.5):
# Restart on failure within 10 seconds
Restart=on-failure
RestartSec=10

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/opt/btb

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/btb /opt/btb /var/btb/queue /var/btb/completed /var/btb/jobs /var/btb/logs
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
TimeoutStopSec=30

# Logging — output goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=btb-service

[Install]
WantedBy=multi-user.target
